# ============================================
# KERBERUS - Swiss Legal Intelligence Platform
# Environment Configuration Template
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# ============================================

# ============================================
# APPLICATION SETTINGS
# ============================================
APP_ENV=development
APP_NAME=KERBERUS
LOG_LEVEL=INFO
SECRET_KEY=generate_random_64_char_secret_here

# ============================================
# DATABASE - PostgreSQL (Auth & Metadata)
# ============================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kerberus_dev
POSTGRES_USER=kerberus_user
POSTGRES_PASSWORD=change_me_in_production

# ============================================
# DATABASE - SQLCipher (Encrypted Dossiers)
# ============================================
DOSSIER_STORAGE_PATH=./data/dossier
SQLCIPHER_ENCRYPTION_ALGORITHM=aes-256-gcm
SQLCIPHER_ITERATIONS=256000
MAX_DOSSIER_SIZE_MB=1024

# ============================================
# REDIS (Sessions & Rate Limiting)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# QDRANT (Vector Database)
# ============================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Optional; honoured by QdrantManager and the health probes when set
QDRANT_API_KEY=
QDRANT_COLLECTION_CODEX=codex
QDRANT_COLLECTION_LIBRARY=library

# ============================================
# DOCUMENT STORE (full texts for the LLM, PostgreSQL)
# ============================================
# Load with: make load-documents. When false/unreachable the app falls back to
# the parsed JSON files under PARSED_DATA_DIR (indexed once, no globbing).
DOCUMENT_STORE_ENABLED=true
PARSED_DATA_DIR=./data/parsed
# Retrieval precision: drop reranked results far below the best hit (raw cross-encoder logits;
# on-point ≈ -6..+3, related ≈ -6..-8, unrelated ≈ -10 and below). Set the gate to false to
# reproduce the old fixed quotas (15 laws + 10 ordinances + 10 decisions regardless of score).
RELEVANCE_GATE_ENABLED=true
RERANK_MIN_LOGIT=-9.0
RERANK_TOP_MARGIN=7.0
# Old behaviour embedded the domain-expanded query for the dense vector too (pulls in unrelated laws)
EXPANDED_DENSE_QUERY=false
# Reranker cost = candidates x tokens per pair. Defaults target ~1 min/query on a CPU-only
# server; raise on a GPU. (RERANKER_MAX_LENGTH replaces the old RERANKER_MAX_LENGTH=512 default)
RERANK_CANDIDATES_LIBRARY=50
RERANK_CANDIDATES_LAWS=40
RERANK_CANDIDATES_ORDINANCES=25
RERANKER_MAX_LENGTH=384
# Extra margin for articles from the same law as the best hit (context, not noise)
RERANK_SAME_LAW_BONUS=3.0
# Add the articles adjacent to the best law hits from the document store (no vector search).
# Recovers articles whose embeddings are poor, e.g. from an index built with the old parser.
CODEX_NEIGHBOUR_EXPANSION=true
CODEX_NEIGHBOUR_SEEDS=3
CODEX_NEIGHBOUR_RADIUS=1
CODEX_NEIGHBOUR_MAX_ADDED=6
# Context budgets (characters, ~4 per token)
MAX_DECISION_CHARS=12000
MAX_DECISIONS_CONTEXT_CHARS=120000
MAX_LAWS_CONTEXT_CHARS=60000

# ============================================
# MODEL SERVICE (optional: run BGE-M3 + reranker as a separate service)
# ============================================
# uvicorn src.services.models_api:app --port 8080   (or the `models` compose service)
# When set, the web/API processes do NOT load the models themselves.
MODEL_SERVICE_URL=
MODEL_SERVICE_TIMEOUT=120
# Warm up models at API startup (default: only when APP_ENV=production)
WARM_UP_MODELS=

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
JWT_SECRET=generate_another_random_secret_here
# Required by the Chainlit UI for signed login cookies. Generate with: chainlit create-secret
CHAINLIT_AUTH_SECRET=generate_with_chainlit_create_secret
# Allow unknown emails to create an account from the Chainlit login form.
# true  = demo mode (anyone can sign up, a typo in the email creates a new account)
# false = only pre-existing accounts (create them via POST /auth/register)
ALLOW_SELF_REGISTRATION=true
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=12
SESSION_EXPIRATION_HOURS=12
MFA_ISSUER=KERBERUS

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_DAILY=300
RATE_LIMIT_HOURLY=50
RATE_LIMIT_ENABLED=true
# Comma-separated origins allowed to call the REST API from a browser
CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# ============================================
# AI MODEL SETTINGS
# ============================================
# Mistral AI (Primary - for development and production)
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest
# Options: mistral-small-latest, mistral-large-latest, open-mistral-nemo

# Dossier envelope keys: PBKDF2 iterations for the password-derived wrapping key
DOSSIER_KDF_ITERATIONS=600000

# ============================================
# INFOMANIAK AI API (Swiss sovereign option)
# ============================================
# Get your product ID from Infomaniak AI dashboard
INFOMANIAK_PRODUCT_ID=your_product_id_here
INFOMANIAK_API_KEY=your_infomaniak_api_key_here

# Models available on Infomaniak (use short names):
# mixtral, llama3, granite, mistral24b, mistral3, qwen3, gemma3n
INFOMANIAK_GUARD_MODEL=mistral24b
INFOMANIAK_ANALYSIS_MODEL=qwen3

# Generic LLM API Key (fallback)
LLM_API_KEY=your_api_key_here

# Pricing (for cost tracking and monitoring)
MISTRAL_INPUT_COST_PER_M=0.20   # CHF per 1M input tokens (mistral-small)
MISTRAL_OUTPUT_COST_PER_M=0.60  # CHF per 1M output tokens

# Development Mode (use mock responses - no API key needed)
# Set to false in production when you have real API keys
USE_MOCK_AI=false

# ============================================
# CONTEXT MANAGEMENT (Day 5 - Dynamic Swapping)
# ============================================
# "The Sliding Window of Truth" pattern
# Prevents token bloat by replacing legal context on each turn
MAX_CONTEXT_TOKENS=4000        # Max tokens for legal context per turn
MAX_CHAT_HISTORY_TURNS=5       # Keep last 5 conversation turns in memory
ENABLE_CONTEXT_SWAPPING=true   # Always replace legal docs (don't accumulate)

# Token Budget Limits
HARD_TOKEN_LIMIT=12000         # Emergency cap per request
WARN_TOKEN_THRESHOLD=10000     # Warning threshold for monitoring

# ============================================
# TOKEN USAGE TRACKING
# ============================================
ENABLE_TOKEN_TRACKING=true
TOKEN_USAGE_LOG_PATH=./logs/token_usage.jsonl
ALERT_COST_THRESHOLD_CHF=50.00  # Alert if user exceeds CHF 50/month

# ============================================
# EMBEDDING MODELS (Local)
# ============================================
# Once the weights are cached, keep the HuggingFace hub offline: the loader otherwise
# contacts the CDN on every start and a stalled connection blocks model loading.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
BGE_MODEL_NAME=BAAI/bge-m3
BGE_RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
EMBEDDER_DEVICE=mps
EMBEDDER_MAX_LENGTH=8192
RERANKER_DEVICE=cpu

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_MFA=true
ENABLE_PII_SCRUBBING=true
ENABLE_FIRM_DOSSIER=false
ENABLE_CITATION_VALIDATION=true

# ============================================
# CONVERSATION PERSISTENCE (Encrypted)
# ============================================
# Encryption key for storing conversation history in PostgreSQL
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty to disable conversation persistence
CONVERSATION_ENCRYPTION_KEY=

# ============================================
# FIRM FEATURES (Phase 2)
# ============================================
# Firm master key storage options: kms, vault, file
FIRM_MASTER_KEY_STORAGE=file  # Use 'file' for dev, 'kms' or 'vault' for production
FIRM_MASTER_KEY_KMS_PATH=     # Infomaniak KMS path (production)
FIRM_MASTER_KEY_VAULT_PATH=   # HashiCorp Vault path (alternative)
FIRM_MASTER_KEY_FILE_PATH=./data/dossier/.firm_master_key  # DEV ONLY - DO NOT use in production
